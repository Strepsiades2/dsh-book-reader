{
  "name": "dsh-book-reader",
  "version": "0.1.0",
  "description": "Read books and papers in DSH: page-aware controls on the official PDF preview, plus cheap text-first PDF context for the model (TOC, search, selective page images).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pdf",
    "reader",
    "pdfjs",
    "vision",
    "book"
  ],
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "author": "strepsiades",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strepsiades/dsh-book-reader.git"
  },
  "homepage": "https://github.com/strepsiades/dsh-book-reader#readme",
  "bugs": {
    "url": "https://github.com/strepsiades/dsh-book-reader/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/core/**/*.js",
    "SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
